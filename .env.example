# AirDoctor Configuration
# Copy this file to .env and populate with your credentials

# ==============================================================================
# LLM Provider Configuration ("bedrock" | "vertexai")
# ==============================================================================
LLM_PROVIDER=bedrock

# --- Amazon Bedrock Configuration (when LLM_PROVIDER=bedrock) ---
AWS_REGION=us-east-1
AWS_PROFILE=default
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
# Optional: Set this to true to use live AWS S3 instead of local offline fixtures
# AIRDOCTOR_S3_BUCKET=my-airdoctor-telemetry-bucket

# --- Google Cloud Vertex AI Configuration (when LLM_PROVIDER=vertexai) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
VERTEX_MODEL_NAME=gemini-3-pro
# VERTEX_TEMPERATURE=0.0
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ==============================================================================
# Notifications & Remediation Targets
# ==============================================================================

# Slack Interactive Approvals
# See docs to get a Slack Bot Token and enable chat:write permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Or alternatively use a webhook
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#data-platform-alerts

# GitHub Automation (For automated PRs during schema drift)
GITHUB_TOKEN=ghp_your_github_token
GITHUB_REPO=your-org/analytics-dbt

# Core Airflow / Kubernetes Settings
DEFAULT_CLUSTER=gke-prod-us-central1
