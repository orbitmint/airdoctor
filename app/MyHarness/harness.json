{
  "name": "MyHarness",
  "model": {
    "provider": "bedrock",
    "modelId": "global.anthropic.claude-sonnet-4-6"
  },
  "tools": [
    {
      "type": "agentcore_browser",
      "name": "browser"
    },
    {
      "type": "agentcore_code_interpreter",
      "name": "code-interpreter"
    },
    {
      "type": "remote_mcp",
      "name": "airdoctor-mcp",
      "config": {
        "remoteMcp": {
          "url": "http://localhost:8081"
        }
      }
    }
  ],
  "skills": [
    {
      "awsSkills": {}
    }
  ],
  "memory": {
    "mode": "managed",
    "strategies": [
      "SEMANTIC",
      "SUMMARIZATION",
      "USER_PREFERENCE",
      "EPISODIC"
    ],
    "eventExpiryDuration": 7
  },
  "maxIterations": 10,
  "maxTokens": 4096,
  "timeoutSeconds": 300,
  "truncation": {
    "strategy": "sliding_window"
  },
  "lifecycleConfig": {
    "idleRuntimeSessionTimeout": 900,
    "maxLifetime": 28800
  },
  "sessionStoragePath": "/mnt/data/"
}